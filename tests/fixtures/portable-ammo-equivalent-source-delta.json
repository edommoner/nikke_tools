    "gpu/admission_runtime.slang": {
      "baseline_sha256": "07d993a0876133e5f448574d074942e455b85fdcfd9ce0bffd22a36f05f25000",
      "current_sha256": "69fabd225d68fe3b1df64fc3bd21bd64a6e770326811dbaee0acfc432ce623b0",
      "changes": [
        {
          "baseline": "        Definition d;loadDefinition(input,j,d); PROJECTILE_ADMIT_ROW(s,j,d)\n",
          "current": "        Definition d;loadDefinition(input,j,d); PROJECTILE_ADMIT_ROW(s,j,d)\n        if(d.kind==37)\n        {\n            if(s.combat==0 || d.stat!=0 || d.target!=0 || d.enemyBuff!=0 || d.healthScaling!=0 || d.alliedFlags!=0 || d.quantityFlags!=0 || d.damageFlags!=0 || d.queryResolve!=0 || (d.flags&~3U)!=0 || !f64Finite(d.value) || f64Less(f64FromI64(4096),f64Abs(d.value))) { s.error=64;break; }\n            uint recipient=input+P_RECIPIENT_BASE+j*8;\n            if(commands[recipient]!=0 || d.owner>=5 || d.recipients!=(1U<<d.owner)) { s.error=64;break; }\n        }\n"
        }
      ]
    },
    "gpu/dispatch_phases.slang": {
      "baseline_sha256": "1e625e6f2ddf707e1cf89c92c9618d0ba58a24e6c28ccf20fa6c18b0faa45644",
      "current_sha256": "02b37a204e65f5db0b5fbf800078a993b0f8ce6599ed20525afab08c2a4fed2c",
      "changes": [
        {
          "baseline": "        }\n",
          "current": "        }\n        else if (d.kind == 37)\n        {\n            uint status;int64_t count=int64_t(f64ToI64(d.value,1,status));\n            if(status!=0) { s.error=16;break; }\n            if(count>1) pushFrame(s,frames,depth,32,0,d.owner,0,f.time,uint(count-1));\n        }\n"
        }
      ]
    },
