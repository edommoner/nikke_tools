          "baseline": "#define PROJECTILE_COUNTER_ROW(s,row,d)\n",
          "current": "#define PROJECTILE_COUNTER_ROW(s,row,d)\n#define PROJECTILE_POOL_ROW(s,row,d)\n"
        },
        {
          "baseline": "#define WORLD_PROJECTILE_KIND(d,legacy) (d.kind==1||d.kind==9||d.kind==10||d.kind==29 ? false : (legacy))\n",
          "current": "#define WORLD_PROJECTILE_KIND(d,legacy) (d.kind==1||d.kind==9||d.kind==10||d.kind==29||d.kind==37 ? false : (legacy))\n"
        },
        {
          "baseline": "        if (f.mode == 15)\n",
          "current": "        if (f.mode == 15 || f.mode == 32)\n"
        },
        {
          "baseline": "            logResourceNotification(s,26,f.owner,uint(f.argument),f.time,ONE,output);\n",
          "current": "            if(f.mode==15) logResourceNotification(s,26,f.owner,uint(f.argument),f.time,ONE,output);\n"
        }
      ]
    },
